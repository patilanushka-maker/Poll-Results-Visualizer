# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# IDE / Editor configuration
.vscode/
.idea/
*.swp
*.swo

# Environment variables & secrets
.env
.env.*
!.env.example

# OS generated files
.DS_Store
Thumbs.db

# Project outputs & exports (keep folder structure via .gitkeep, ignore generated outputs)
outputs/reports/*
!outputs/reports/.gitkeep
outputs/exports/*
!outputs/exports/.gitkeep

# Sensitive or large raw datasets (do NOT ignore data/synthetic sample datasets)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
